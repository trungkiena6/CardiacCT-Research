root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.sh]
indent_size = 2
shell_variant = bash
switch_case_indent = true
space_redirects = true

[*.{csv,json}]
trim_trailing_whitespace = false
